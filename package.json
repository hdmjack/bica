{
  "name": "bica",
  "version": "0.0.1",
  "description": "Remote workspace CLI — file sync, SSH, and argv-safe remote commands",
  "license": "MIT",
  "author": "Haakon Jack",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "bica": "./bin/bica.cjs"
  },
  "files": [
    "bin",
    "scripts",
    "src",
    "README.md",
    "tsconfig.json"
  ],
  "scripts": {
    "build": "node ./scripts/build.cjs",
    "dev": "node ./scripts/dev.cjs",
    "lint": "eslint . --quiet",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "es-toolkit": "^1.46.0",
    "prompts": "^2.4.2",
    "tsx": "^4.21.0",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/prompts": "^2.4.9",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "eslint": "^10.2.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
